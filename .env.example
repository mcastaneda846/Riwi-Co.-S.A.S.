# URL de conexión a la base de datos PostgreSQL
DATABASE_URL=postgresql://USUARIO:PASSWORD@HOST:PUERTO/NOMBRE_BD

# Clave secreta para firmar y verificar tokens JWT
JWT_SECRET=TU_JWT_SECRET_KEY_AQUI

# Clave de API de Google Gemini (AI Studio)
RIWI_API_KEY=TU_GEMINI_API_KEY_AQUI

# Clave de API de OpenAI (Opcional - Fallback)
OPENAI_API_KEY=TU_OPENAI_API_KEY_AQUI
